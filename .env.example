# AI PDF Chatbot Environment Variables
#
# FOR LOCAL DEVELOPMENT:
# Use environment-local.ts instead (copy from environment-local-example.ts)
#
# FOR PRODUCTION/DEPLOYMENT:
# Use these environment variables in your deployment platform

# OpenAI Configuration (Required)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Application Settings
NODE_ENV=production
PORT=4000

# Optional: Future API integrations
# PINECONE_API_KEY=your-pinecone-api-key-here
# PINECONE_INDEX_NAME=pdf-reader
# PINECONE_ENVIRONMENT=us-east-1